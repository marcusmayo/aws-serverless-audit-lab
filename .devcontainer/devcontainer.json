{
  "name": "AWS Serverless Audit Lab",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/customink/codespaces-features/sam-cli:1.2.0": {}
  },
  "postCreateCommand": "VENV_DIR=.venv bash scripts/bootstrap_env.sh dev",
  "postStartCommand": "VENV_DIR=.venv bash scripts/preview_server.sh start",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "AWS Audit Lab Preview",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "amazonwebservices.aws-toolkit-vscode"
      ]
    }
  }
}
